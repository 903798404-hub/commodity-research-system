htmlcov/

# Local credentials
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Runtime data, generated outputs, and logs
01_data/
06_outputs/
10_logs/

# Release facts are sealed only after an image exists, so they cannot be part of
# the Git commit that identifies that same image. Keep them locally without
# making the formal repository dirty; retain only the tracked directory policy.
09_deploy/releases/*
!09_deploy/releases/说明.md
output/
raw/
data/raw/
data/snapshots/
*.log

# Build artifacts, dependencies, and temporary files
node_modules/
dist/
*.tsbuildinfo
*.tmp
*.temp
*.bak
.DS_Store
Thumbs.db
.vscode/
.idea/
*-server-latest/

