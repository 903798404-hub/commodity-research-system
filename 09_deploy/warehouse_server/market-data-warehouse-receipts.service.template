[Unit]
Description=Incremental Tushare warehouse receipts and verified atomic publication
RequiresMountsFor=/var/lib/market-data
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I -B @SOURCE_ROOT@/09_deploy/warehouse_server/run.py --config @CONFIG_PATH@ --retry-if-needed
TimeoutStartSec=17min
UMask=0077
Nice=10
StandardOutput=journal
StandardError=journal
