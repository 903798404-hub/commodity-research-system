[Unit]
Description=Warehouse receipts Beijing 16:15 with conditional evening and morning retries

[Timer]
OnCalendar=Mon..Fri *-*-* 16:15:00 Asia/Shanghai
OnCalendar=*-*-* 17:30:00 Asia/Shanghai
OnCalendar=*-*-* 18:30:00 Asia/Shanghai
OnCalendar=*-*-* 20:00:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 22:00:00 Asia/Shanghai
OnCalendar=Tue..Sat *-*-* 08:40:00 Asia/Shanghai
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=market-data-task-enqueue@warehouse.service

[Install]
WantedBy=timers.target
