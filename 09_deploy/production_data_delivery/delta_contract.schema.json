{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production crop/FAS/canola data delta transfer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "delta_id",
    "generated_at_utc",
    "domain",
    "producer",
    "run",
    "baseline",
    "domain_metadata",
    "payloads"
  ],
  "properties": {
    "schema_version": {"const": "production-data-delta/1"},
    "status": {"const": "CANDIDATE"},
    "delta_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "domain": {"enum": ["soybean_crop_progress", "soybean_export_sales", "canada_canola"]},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "origin"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "origin": {"enum": [
          "git@github.com:903798404-hub/commodity-research-system.git",
          "https://github.com/903798404-hub/commodity-research-system.git"
        ]}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "git_head", "business_status", "published"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,120}$"},
        "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "business_status": {"enum": ["initialized", "updated", "no_change"]},
        "published": {"const": false}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/fileIdentity"}
            ]
          }
        }
      }
    },
    "domain_metadata": {"type": "object"},
    "payloads": {
      "type": "object",
      "additionalProperties": {"oneOf": [{"$ref": "#/$defs/parquetIdentity"}, {"$ref": "#/$defs/fileIdentity"}]}
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "parquetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes", "row_count", "parquet_schema_sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 1},
        "parquet_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"domain": {"const": "soybean_crop_progress"}}},
      "then": {
        "properties": {
          "baseline": {
            "properties": {
              "files": {
                "additionalProperties": false,
                "required": [
                  "01_data/processed/soybean_crop_progress/soybeans_crop_progress_weekly.parquet",
                  "01_data/processed/soybean_crop_progress/soybeans_crop_condition_weekly.parquet",
                  "01_data/processed/soybean_crop_progress/soybeans_crop_progress_weekly_2021_2026.parquet",
                  "01_data/processed/soybean_crop_progress/soybeans_crop_condition_weekly_2021_2026.parquet",
                  "01_data/update_status/soybean_crop_progress.json"
                ],
                "properties": {
                  "01_data/processed/soybean_crop_progress/soybeans_crop_progress_weekly.parquet": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileIdentity"}]},
                  "01_data/processed/soybean_crop_progress/soybeans_crop_condition_weekly.parquet": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileIdentity"}]},
                  "01_data/processed/soybean_crop_progress/soybeans_crop_progress_weekly_2021_2026.parquet": {"$ref": "#/$defs/fileIdentity"},
                  "01_data/processed/soybean_crop_progress/soybeans_crop_condition_weekly_2021_2026.parquet": {"$ref": "#/$defs/fileIdentity"},
                  "01_data/update_status/soybean_crop_progress.json": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileIdentity"}]}
                }
              }
            }
          },
          "domain_metadata": {
            "additionalProperties": false,
            "required": ["current_year", "retrieved_at_utc", "raw_snapshot", "duplicate_counts", "source_manifest_sha256"],
            "properties": {
              "current_year": {"type": "integer", "minimum": 2021},
              "retrieved_at_utc": {"type": "string", "minLength": 1},
              "raw_snapshot": {"type": "string", "pattern": "^01_data/raw/soybean_crop_progress/nass_soybeans_crop_weekly_[0-9]{4}_[0-9]{8}T(?:[0-9]{6}|[0-9]{12})Z\\.json$"},
              "duplicate_counts": {
                "type": "object",
                "additionalProperties": false,
                "required": ["PROGRESS", "CONDITION"],
                "properties": {
                  "PROGRESS": {"type": "integer", "minimum": 0},
                  "CONDITION": {"type": "integer", "minimum": 0}
                }
              },
              "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "payloads": {
            "additionalProperties": false,
            "required": ["soybeans_crop_progress_weekly.parquet", "soybeans_crop_condition_weekly.parquet"],
            "properties": {
              "soybeans_crop_progress_weekly.parquet": {"$ref": "#/$defs/parquetIdentity"},
              "soybeans_crop_condition_weekly.parquet": {"$ref": "#/$defs/parquetIdentity"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"domain": {"const": "soybean_export_sales"}}},
      "then": {
        "properties": {
          "baseline": {
            "properties": {
              "files": {
                "additionalProperties": false,
                "required": [
                  "01_data/processed/soybean_export_sales/soybean_export_sales_weekly.parquet",
                  "01_data/processed/soybean_export_sales/soybean_export_sales_weekly.manifest.json",
                  "01_data/update_status/soybean_export_sales.json"
                ],
                "properties": {
                  "01_data/processed/soybean_export_sales/soybean_export_sales_weekly.parquet": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileIdentity"}]},
                  "01_data/processed/soybean_export_sales/soybean_export_sales_weekly.manifest.json": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileIdentity"}]},
                  "01_data/update_status/soybean_export_sales.json": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileIdentity"}]}
                }
              }
            }
          },
          "domain_metadata": {
            "additionalProperties": false,
            "required": ["batch_id", "source", "source_latest_week", "source_release_time_raw", "source_release_timezone", "fetch_scope", "raw_snapshot_sha256", "raw_manifest_sha256", "quality_status"],
            "properties": {
              "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,120}$"},
              "source": {"const": "usda_fas_esr"},
              "source_latest_week": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "source_release_time_raw": {"type": "string", "minLength": 1},
              "source_release_timezone": {"const": "America/New_York"},
              "fetch_scope": {
                "type": "object",
                "additionalProperties": false,
                "required": ["report_market_years"],
                "properties": {
                  "report_market_years": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "integer", "minimum": 2000}
                  }
                }
              },
              "raw_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "raw_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "quality_status": {"const": "passed"}
            }
          },
          "payloads": {
            "additionalProperties": false,
            "required": ["soybean_export_sales_weekly.parquet"],
            "properties": {
              "soybean_export_sales_weekly.parquet": {"$ref": "#/$defs/parquetIdentity"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "canada_canola"
          }
        }
      },
      "then": {
        "properties": {
          "baseline": {
            "properties": {
              "files": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "01_data/processed/canada_canola/canola_weekly.json",
                  "01_data/processed/canada_canola/source_evidence.json",
                  "01_data/update_status/canada_canola.json"
                ],
                "properties": {
                  "01_data/processed/canada_canola/canola_weekly.json": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/fileIdentity"
                      }
                    ]
                  },
                  "01_data/processed/canada_canola/source_evidence.json": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/fileIdentity"
                      }
                    ]
                  },
                  "01_data/update_status/canada_canola.json": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/fileIdentity"
                      }
                    ]
                  }
                }
              }
            }
          },
          "domain_metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_count",
              "latest_dates",
              "revision_keys"
            ],
            "properties": {
              "record_count": {
                "type": "integer",
                "minimum": 1
              },
              "latest_dates": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "patternProperties": {
                  "^(SK|AB|MB)/(PLANTED|HARVESTED|GOOD_EXCELLENT|PRE_EMERGING|SEEDLING|ROSETTE|BOLTING|FLOWERING|PODDED|RIPE)$": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              },
              "revision_keys": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(SK|AB|MB)/(PLANTED|HARVESTED|GOOD_EXCELLENT|PRE_EMERGING|SEEDLING|ROSETTE|BOLTING|FLOWERING|PODDED|RIPE)/[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              }
            }
          },
          "payloads": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canola_weekly.json",
              "source_evidence.json"
            ],
            "properties": {
              "canola_weekly.json": {
                "$ref": "#/$defs/fileIdentity"
              },
              "source_evidence.json": {
                "$ref": "#/$defs/fileIdentity"
              }
            }
          }
        }
      }
    }
  ]
}
