{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "application", "release_id", "git_commit", "git_tree", "candidate_image_id", "candidate_container", "identity", "formal_containers", "data_identity", "checks", "log_summary", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "application": {"const": "oil-world-dashboard"}, "release_id": {"type": "string"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "candidate_container": {"type": "string"},
    "identity": {"type": "object", "required": ["actual_image_id", "oci_revision", "runtime_git_commit", "embedded_git_commit", "embedded_git_tree"], "properties": {"actual_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "oci_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "runtime_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "embedded_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "embedded_git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}, "additionalProperties": false},
    "formal_containers": {"type": "object", "required": ["before_phase", "after_phase", "containers", "unchanged"], "properties": {"before_phase": {"const": "before-candidate"}, "after_phase": {"const": "after-candidate"}, "containers": {"type": "array", "minItems": 3}, "unchanged": {"const": true}}, "additionalProperties": false},
    "data_identity": {"type": "object", "required": ["host_path", "read_only", "tree_sha256"], "properties": {"host_path": {"type": "string"}, "read_only": {"const": true}, "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "checks": {"type": "object", "required": ["http", "pages", "assets", "data", "restart_count", "production_switch_performed"], "properties": {"http": {"type": "object"}, "pages": {"const": "passed"}, "assets": {"const": "passed"}, "data": {"const": "unchanged"}, "restart_count": {"const": 0}, "production_switch_performed": {"const": false}}, "additionalProperties": false},
    "log_summary": {"type": "object", "required": ["requested_lines", "sampled_bytes", "tail_bytes", "tail_sha256", "error_markers"], "properties": {"requested_lines": {"const": 200}, "sampled_bytes": {"type": "integer", "minimum": 0}, "tail_bytes": {"type": "integer", "minimum": 0}, "tail_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "error_markers": {"type": "array", "maxItems": 0}}, "additionalProperties": false},
    "status": {"const": "candidate-validated"}, "created_at": {"type": "string", "minLength": 20}
  }, "additionalProperties": false
}
