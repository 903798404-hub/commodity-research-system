{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object",
  "required": ["schema_version", "application", "release_id", "git_commit", "git_tree", "image_ref", "formal_image_ref", "candidate_image_id", "candidate_result_sha256", "candidate_container_removed", "formal_containers", "tool_repo_root", "production_compose_file", "production_project_dir", "production_env_file", "production_baseline", "compose_project", "service", "data_identity", "rollback", "execute_argv", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "application": {"const": "oil-world-dashboard"}, "release_id": {"type": "string"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "image_ref": {"type": "string", "minLength": 12}, "formal_image_ref": {"type": "string", "minLength": 12}, "candidate_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "candidate_container_removed": {"const": true},
    "formal_containers": {"type": "object", "required": ["before_phase", "after_phase", "containers", "unchanged"], "properties": {"before_phase": {"const": "after-candidate"}, "after_phase": {"const": "pre-deploy"}, "containers": {"type": "array", "minItems": 3}, "unchanged": {"const": true}}, "additionalProperties": false},
    "tool_repo_root": {"type": "string", "minLength": 1}, "production_compose_file": {"type": "string", "minLength": 1}, "production_project_dir": {"type": "string", "minLength": 1}, "production_env_file": {"type": "string", "minLength": 1}, "production_baseline": {"type": "object", "required": ["compose_sha256", "env_sha256", "image_ref"], "properties": {"compose_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "env_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "image_ref": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "compose_project": {"const": "market-data-oil-world"}, "service": {"const": "oil-world-dashboard"},
    "data_identity": {"type": "object", "required": ["host_path", "read_only", "tree_sha256"], "properties": {"host_path": {"type": "string"}, "read_only": {"const": true}, "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "rollback": {"type": "object", "required": ["image_ref", "image_id", "git_commit"], "properties": {"image_ref": {"type": "string"}, "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}, "additionalProperties": false},
    "execute_argv": {"type": "array", "minItems": 12, "items": {"type": "string"}}, "status": {"const": "deployment_plan_sealed"}, "created_at": {"type": "string", "minLength": 20}
  }, "additionalProperties": false
}
