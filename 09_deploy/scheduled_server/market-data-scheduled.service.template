[Unit]
Description=Server-owned @JOB@ collection and protected publication
RequiresMountsFor=/var/lib/market-data
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I -B @SOURCE_ROOT@/09_deploy/scheduled_server/run.py --config @CONFIG_PATH@ --publish
TimeoutStartSec=90min
UMask=0022
Nice=10
StandardOutput=journal
StandardError=journal
