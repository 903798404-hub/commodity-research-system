# Server-only formal environment contract. Copy this outside Git as
# /home/ubuntu/.config/market-data/usda-production.env with mode 0600.
# This file deliberately has no Spread, weather, Oil World, API-key, or data
# variables. Use an immutable existing USDA image reference.
USDA_IMAGE=market-data-usda-dashboard:replace-with-current-immutable-tag
USDA_HOST_PORT=8080
USDA_NETWORK_NAME=market-data_default
USDA_RUNTIME_DATA_ROOT=/home/ubuntu/market-data-runtime/usda/data
