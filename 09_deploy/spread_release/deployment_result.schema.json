{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity-research-system.invalid/schemas/spread-deployment-result-1.2.0.json",
  "title": "spread-dashboard verified production deployment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application",
    "release_id",
    "git_commit",
    "target_git_commit",
    "git_tree",
    "image_ref",
    "candidate_image_id",
    "actual_image_id",
    "oci_revision",
    "runtime_git_commit",
    "runtime_git_commit_verified",
    "container_name",
    "config_image",
    "compose_project",
    "production_service",
    "deployment_plan",
    "deployment_plan_sha256",
    "production_env_file",
    "production_env_sha256",
    "production_compose_sha256",
    "weather_runtime_contract",
    "weather_candidate_mode",
    "weather_candidate_source",
    "weather_runtime_current_dir",
    "weather_data_promotion_required",
    "weather_data_changed",
    "processed_next_created",
    "processed_current_modified",
    "readiness",
    "readiness_result",
    "readiness_result_sha256",
    "http_status",
    "generated_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "application": {
      "const": "spread-dashboard"
    },
    "release_id": {
      "type": "string",
      "pattern": "spread-[0-9]{8}-[0-9a-f]{12,40}-b[0-9]{2,}"
    },
    "git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "target_git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "git_tree": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "image_ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate_image_id": {
      "$ref": "#/$defs/imageId"
    },
    "actual_image_id": {
      "$ref": "#/$defs/imageId"
    },
    "oci_revision": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "runtime_git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "runtime_git_commit_verified": {
      "const": true
    },
    "container_name": {
      "const": "spread-dashboard"
    },
    "config_image": {
      "type": "string",
      "minLength": 1
    },
    "compose_project": {
      "const": "market-data"
    },
    "production_service": {
      "const": "spread-dashboard"
    },
    "deployment_plan": {
      "type": "string",
      "minLength": 1
    },
    "deployment_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "production_env_file": {
      "type": "string",
      "minLength": 1
    },
    "production_env_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "production_compose_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "weather_runtime_contract": {
      "$ref": "#/$defs/weatherRuntimeContract"
    },
    "weather_candidate_mode": { "enum": ["current", "next"] },
    "weather_candidate_source": {
      "enum": [
        "/home/ubuntu/market-data-runtime/weather/processed/current",
        "/home/ubuntu/market-data-runtime/weather/processed/next"
      ]
    },
    "weather_runtime_current_dir": { "const": "/home/ubuntu/market-data-runtime/weather/processed/current" },
    "weather_data_promotion_required": { "type": "boolean" },
    "weather_data_changed": { "type": "boolean" },
    "processed_next_created": { "const": false },
    "processed_current_modified": { "const": false },
    "readiness": {
      "type": "object"
    },
    "readiness_result": {
      "type": "string",
      "minLength": 1
    },
    "readiness_result_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "http_status": {
      "const": 200
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "const": "production_verified"
    }
  },
  "$defs": {
    "weatherRuntimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_variable",
        "production_host_path",
        "allowed_candidate_host_paths",
        "container_path",
        "read_only",
        "weather_data_dir"
      ],
      "properties": {
        "environment_variable": { "const": "WEATHER_RUNTIME_CURRENT_DIR" },
        "production_host_path": { "const": "/home/ubuntu/market-data-runtime/weather/processed/current" },
        "allowed_candidate_host_paths": {
          "const": [
            "/home/ubuntu/market-data-runtime/weather/processed/current",
            "/home/ubuntu/market-data-runtime/weather/processed/next"
          ]
        },
        "container_path": { "const": "/app/runtime/weather" },
        "read_only": { "const": true },
        "weather_data_dir": { "const": "/app/runtime/weather" }
      }
    },
    "fullGitCommit": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "imageId": {
      "type": "string",
      "pattern": "sha256:[0-9a-f]{64}"
    },
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    }
  }
}
