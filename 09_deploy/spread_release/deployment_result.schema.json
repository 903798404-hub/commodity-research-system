{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity-research-system.invalid/schemas/spread-deployment-result-1.1.0.json",
  "title": "spread-dashboard verified production deployment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application",
    "release_id",
    "git_commit",
    "target_git_commit",
    "git_tree",
    "image_ref",
    "candidate_image_id",
    "actual_image_id",
    "oci_revision",
    "runtime_git_commit",
    "runtime_git_commit_verified",
    "container_name",
    "config_image",
    "compose_project",
    "production_service",
    "deployment_plan",
    "deployment_plan_sha256",
    "production_env_file",
    "production_env_sha256",
    "production_compose_sha256",
    "readiness",
    "readiness_result",
    "readiness_result_sha256",
    "http_status",
    "generated_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "application": {
      "const": "spread-dashboard"
    },
    "release_id": {
      "type": "string",
      "pattern": "spread-[0-9]{8}-[0-9a-f]{12,40}-b[0-9]{2,}"
    },
    "git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "target_git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "git_tree": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "image_ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate_image_id": {
      "$ref": "#/$defs/imageId"
    },
    "actual_image_id": {
      "$ref": "#/$defs/imageId"
    },
    "oci_revision": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "runtime_git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "runtime_git_commit_verified": {
      "const": true
    },
    "container_name": {
      "const": "spread-dashboard"
    },
    "config_image": {
      "type": "string",
      "minLength": 1
    },
    "compose_project": {
      "const": "market-data"
    },
    "production_service": {
      "const": "spread-dashboard"
    },
    "deployment_plan": {
      "type": "string",
      "minLength": 1
    },
    "deployment_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "production_env_file": {
      "type": "string",
      "minLength": 1
    },
    "production_env_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "production_compose_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "readiness": {
      "type": "object"
    },
    "readiness_result": {
      "type": "string",
      "minLength": 1
    },
    "readiness_result_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "http_status": {
      "const": 200
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "const": "production_verified"
    }
  },
  "$defs": {
    "fullGitCommit": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "imageId": {
      "type": "string",
      "pattern": "sha256:[0-9a-f]{64}"
    },
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    }
  }
}
