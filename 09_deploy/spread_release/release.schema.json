{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity-research-system.invalid/schemas/spread-release-2.3.0.json",
  "title": "spread-dashboard immutable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application",
    "release_id",
    "git_commit",
    "git_tree",
    "image_ref",
    "image_id",
    "image_oci_revision",
    "image_release_json_sha256",
    "build_time",
    "compose_project",
    "compose_files",
    "dockerfile_sha256",
    "dockerignore_sha256",
    "required_config_sha256",
    "candidate_container_name",
    "rollback_image_ref",
    "rollback_image_id",
    "formal_git_commit",
    "data_baseline",
    "weather_candidate_mode",
    "weather_candidate_source",
    "weather_runtime_current_dir",
    "weather_data_promotion_required",
    "weather_data_changed",
    "processed_next_created",
    "processed_current_modified",
    "weather_runtime_contract",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.4.0"
          }
        }
      },
      "then": {
        "required": [
          "readiness_policy",
          "runtime_environment_contract",
          "candidate_user_url_environment"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "2.0.0",
        "2.1.0",
        "2.2.0",
        "2.3.0",
        "2.4.0"
      ]
    },
    "application": {
      "const": "spread-dashboard"
    },
    "release_id": {
      "type": "string",
      "pattern": "spread-[0-9]{8}-[0-9a-f]{12,40}-b[0-9]{2,}"
    },
    "git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "git_tree": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "image_ref": {
      "type": "string",
      "pattern": "(?:^|/)market-data-spread-dashboard:spread-[0-9]{8}-[0-9a-f]{12,40}-b[0-9]{2,}"
    },
    "image_id": {
      "$ref": "#/$defs/imageId"
    },
    "image_oci_revision": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "image_release_json_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "build_time": {
      "type": "string",
      "minLength": 20
    },
    "compose_project": {
      "const": "market-data"
    },
    "compose_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compose_config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "compose_template_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_environment_contract": {
      "$ref": "#/$defs/runtimeEnvironmentContract"
    },
    "candidate_user_url_environment": {
      "$ref": "#/$defs/userUrlEnvironment"
    },
    "weather_candidate_mode": { "enum": ["current", "next"] },
    "weather_candidate_source": {
      "enum": [
        "/home/ubuntu/market-data-runtime/weather/processed/current",
        "/home/ubuntu/market-data-runtime/weather/processed/next"
      ]
    },
    "weather_runtime_current_dir": { "const": "/home/ubuntu/market-data-runtime/weather/processed/current" },
    "weather_data_promotion_required": { "type": "boolean" },
    "weather_data_changed": { "type": "boolean" },
    "processed_next_created": { "const": false },
    "processed_current_modified": { "const": false },
    "weather_runtime_contract": { "$ref": "#/$defs/weatherRuntimeMount" },
    "readiness_policy": {
      "$ref": "#/$defs/readinessPolicy"
    },
    "dockerfile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "dockerignore_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "required_config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_container_name": {
      "type": "string",
      "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]+"
    },
    "rollback_image_ref": {
      "type": "string",
      "pattern": "(?:^|/)market-data-spread-dashboard:[A-Za-z0-9_][A-Za-z0-9_.-]*"
    },
    "rollback_image_id": {
      "$ref": "#/$defs/imageId"
    },
    "formal_git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "data_baseline": {
      "$ref": "#/$defs/dataBaseline"
    },
    "status": {
      "const": "candidate_sealed"
    }
  },
  "$defs": {
    "userUrlEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "USDA_DASHBOARD_URL",
        "OIL_WORLD_DASHBOARD_URL"
      ],
      "properties": {
        "USDA_DASHBOARD_URL": { "type": "string", "minLength": 8 },
        "OIL_WORLD_DASHBOARD_URL": { "type": "string", "minLength": 8 }
      }
    },
    "fullGitCommit": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "imageId": {
      "type": "string",
      "pattern": "sha256:[0-9a-f]{64}"
    },
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "runtimeEnvironmentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_production_variables",
        "required_production_variables",
        "release_bound_variables",
        "allowed_candidate_production_differences",
        "undeclared_variables_forbidden"
        ,"weather_runtime_mount"
      ],
      "properties": {
        "allowed_production_variables": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SPREAD_IMAGE",
              "MARKET_DATA_GIT_HEAD",
              "USDA_DASHBOARD_URL",
              "OIL_WORLD_DASHBOARD_URL",
              "WEATHER_RUNTIME_CURRENT_DIR"
            ]
          }
        },
        "required_production_variables": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SPREAD_IMAGE",
              "MARKET_DATA_GIT_HEAD",
              "USDA_DASHBOARD_URL",
              "OIL_WORLD_DASHBOARD_URL",
              "WEATHER_RUNTIME_CURRENT_DIR"
            ]
          }
        },
        "release_bound_variables": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "SPREAD_IMAGE",
            "MARKET_DATA_GIT_HEAD"
          ],
          "properties": {
            "SPREAD_IMAGE": {
              "const": "image_ref"
            },
            "MARKET_DATA_GIT_HEAD": {
              "const": "git_commit"
            }
          }
        },
        "allowed_candidate_production_differences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "USDA_DASHBOARD_URL",
              "OIL_WORLD_DASHBOARD_URL"
            ]
          }
        },
        "undeclared_variables_forbidden": {
          "const": true
        },
        "weather_runtime_mount": {
          "$ref": "#/$defs/weatherRuntimeMount"
        }
      }
    },
    "weatherRuntimeMount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_variable",
        "production_host_path",
        "allowed_candidate_host_paths",
        "container_path",
        "read_only",
        "weather_data_dir"
      ],
      "properties": {
        "environment_variable": { "const": "WEATHER_RUNTIME_CURRENT_DIR" },
        "production_host_path": { "const": "/home/ubuntu/market-data-runtime/weather/processed/current" },
        "allowed_candidate_host_paths": {
          "const": [
            "/home/ubuntu/market-data-runtime/weather/processed/current",
            "/home/ubuntu/market-data-runtime/weather/processed/next"
          ]
        },
        "container_path": { "const": "/app/runtime/weather" },
        "read_only": { "const": true },
        "weather_data_dir": { "const": "/app/runtime/weather" }
      }
    },
    "readinessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_timeout_seconds",
        "poll_interval_seconds",
        "request_timeout_seconds",
        "consecutive_successes",
        "health_endpoint_path",
        "success_http_status",
        "success_body_exact"
      ],
      "properties": {
        "total_timeout_seconds": {
          "type": "integer",
          "minimum": 60
        },
        "poll_interval_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "request_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "consecutive_successes": {
          "type": "integer",
          "minimum": 2
        },
        "health_endpoint_path": {
          "type": "string",
          "pattern": "^/[^?#]*$"
        },
        "success_http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "success_body_exact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "host_path",
        "container_path",
        "delivery",
        "persistence",
        "filename",
        "sha256",
        "size_bytes",
        "mtime",
        "records",
        "latest_business_date",
        "primary_key",
        "primary_key_null_rows",
        "duplicate_rows_on_key",
        "update_task",
        "writes_to"
      ],
      "properties": {
        "name": {
          "enum": [
            "spread",
            "basis",
            "soybean_progress",
            "soybean_condition"
          ]
        },
        "host_path": {
          "type": "string",
          "minLength": 1
        },
        "container_path": {
          "type": "string",
          "pattern": "/app/01_data/.+"
        },
        "delivery": {
          "const": "bind_mount"
        },
        "persistence": {
          "const": "host"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mtime": {
          "type": "string",
          "minLength": 20
        },
        "records": {
          "type": "integer",
          "minimum": 1
        },
        "latest_business_date": {
          "type": "string",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        "primary_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_key_null_rows": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_rows_on_key": {
          "type": "integer",
          "minimum": 0
        },
        "update_task": {
          "type": "string",
          "minLength": 1
        },
        "writes_to": {
          "const": "host_through_bind_mount"
        }
      }
    },
    "dataBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "captured_at",
        "mutable_after_deployment",
        "datasets"
      ],
      "properties": {
        "kind": {
          "const": "deployment-time"
        },
        "captured_at": {
          "type": "string",
          "minLength": 20
        },
        "mutable_after_deployment": {
          "const": true
        },
        "datasets": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/dataset"
          }
        }
      }
    }
  }
}
