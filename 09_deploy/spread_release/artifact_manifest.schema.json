{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity-research-system.invalid/schemas/spread-artifact-manifest-1.4.0.json",
  "title": "spread-dashboard sealed JSON artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "target_file",
    "target_sha256",
    "target_size_bytes",
    "target_schema_version",
    "generated_at",
    "release_id",
    "git_commit",
    "git_tree",
    "image_id",
    "formal_evidence_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.4.0"
    },
    "artifact_type": {
      "enum": [
        "release",
        "candidate_result",
        "deployment_plan",
        "deployment_result"
      ]
    },
    "target_file": {
      "enum": [
        "release.json",
        "candidate_result.json",
        "deployment_plan.json",
        "deployment_result.json"
      ]
    },
    "target_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "target_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "release_id": {
      "type": "string",
      "pattern": "spread-[0-9]{8}-[0-9a-f]{12,40}-b[0-9]{2,}"
    },
    "git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "git_tree": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "image_id": {
      "$ref": "#/$defs/imageId"
    },
    "formal_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": {
            "enum": [
              "candidate_result",
              "deployment_result"
            ]
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "required": [
          "runtime_git_commit"
        ]
      },
      "else": {
        "not": {
          "required": [
            "runtime_git_commit"
          ]
        }
      }
    }
  ],
  "oneOf": [
    {
      "properties": {
        "artifact_type": {
          "const": "release"
        },
        "target_file": {
          "const": "release.json"
        },
        "target_schema_version": {
          "const": "2.5.0"
        }
      },
      "required": [
        "artifact_type",
        "target_file",
        "target_schema_version"
      ]
    },
    {
      "properties": {
        "artifact_type": {
          "const": "candidate_result"
        },
        "target_file": {
          "const": "candidate_result.json"
        },
        "target_schema_version": {
          "const": "1.4.0"
        }
      },
      "required": [
        "artifact_type",
        "target_file",
        "target_schema_version"
      ]
    },
    {
      "properties": {
        "artifact_type": {
          "const": "deployment_plan"
        },
        "target_file": {
          "const": "deployment_plan.json"
        },
        "target_schema_version": {
          "const": "1.4.0"
        }
      },
      "required": [
        "artifact_type",
        "target_file",
        "target_schema_version"
      ]
    },
    {
      "properties": {
        "artifact_type": {
          "const": "deployment_result"
        },
        "target_file": {
          "const": "deployment_result.json"
        },
        "target_schema_version": {
          "const": "1.3.0"
        }
      },
      "required": [
        "artifact_type",
        "target_file",
        "target_schema_version"
      ]
    }
  ],
  "$defs": {
    "fullGitCommit": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "imageId": {
      "type": "string",
      "pattern": "sha256:[0-9a-f]{64}"
    },
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    }
  }
}
