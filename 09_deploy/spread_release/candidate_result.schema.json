{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity-research-system.invalid/schemas/spread-candidate-result-1.6.0.json",
  "title": "spread-dashboard candidate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application",
    "release_id",
    "git_commit",
    "git_tree",
    "image_ref",
    "candidate_image_id",
    "candidate_container_name",
    "generated_at",
    "status",
    "weather_runtime_contract",
    "weather_candidate_mode",
    "weather_candidate_source",
    "weather_candidate_data_dir",
    "weather_runtime_current_dir",
    "weather_data_promotion_required",
    "weather_data_changed",
    "processed_next_created",
    "processed_current_modified",
    "identity",
    "formal_containers",
    "log_summary",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.5.0", "1.6.0"]
    },
    "application": {
      "const": "spread-dashboard"
    },
    "release_id": {
      "type": "string",
      "pattern": "spread-[0-9]{8}-[0-9a-f]{12,40}-b[0-9]{2,}"
    },
    "git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "git_tree": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "image_ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate_image_id": {
      "$ref": "#/$defs/imageId"
    },
    "candidate_container_name": {
      "type": "string",
      "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]+"
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "enum": ["candidate-validated", "candidate-waiting-gate"]
    },
    "blocking_gates": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/pendingGate" }
    },
    "completed_gates": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/completedGate" }
    },
    "runtime_mounts": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/importProfitRuntimeMount" }
    },
    "candidate_runtime_access": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/candidateRuntimeAccess" }
      ]
    },
    "weather_runtime_contract": {
      "$ref": "#/$defs/weatherRuntimeContract"
    },
    "weather_candidate_mode": { "enum": ["current", "next"] },
    "weather_candidate_source": { "const": "/home/ubuntu/market-data-runtime/weather/processed" },
    "weather_candidate_data_dir": { "enum": ["/app/runtime/weather/current", "/app/runtime/weather/next"] },
    "weather_runtime_current_dir": { "const": "/home/ubuntu/market-data-runtime/weather/processed" },
    "weather_data_promotion_required": { "type": "boolean" },
    "weather_data_changed": { "type": "boolean" },
    "processed_next_created": { "const": false },
    "processed_current_modified": { "const": false },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_image",
        "actual_image_id",
        "tag_image_id",
        "release_image_id",
        "oci_revision",
        "runtime_git_commit",
        "embedded_release_sha256"
      ],
      "properties": {
        "config_image": {
          "type": "string",
          "minLength": 1
        },
        "actual_image_id": {
          "$ref": "#/$defs/imageId"
        },
        "tag_image_id": {
          "$ref": "#/$defs/imageId"
        },
        "release_image_id": {
          "$ref": "#/$defs/imageId"
        },
        "oci_revision": {
          "$ref": "#/$defs/fullGitCommit"
        },
        "runtime_git_commit": {
          "$ref": "#/$defs/fullGitCommit"
        },
        "embedded_release_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "formal_containers": {
      "$ref": "#/$defs/formalContainerEvidence"
    },
    "log_summary": {
      "$ref": "#/$defs/logSummary"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readiness",
        "http",
        "pages",
        "formal_containers_unchanged",
        "formal_git_unchanged",
        "data_files_unchanged",
        "production_switch_performed"
      ],
      "properties": {
        "readiness": {
          "type": "object"
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "health",
            "host_config",
            "root"
          ],
          "properties": {
            "health": {
              "const": 200
            },
            "host_config": {
              "const": 200
            },
            "root": {
              "const": 200
            }
          }
        },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "passed"
            }
          }
        },
        "server_store_contract": {
          "$ref": "#/$defs/serverStoreContract"
        },
        "formal_containers_unchanged": {
          "const": true
        },
        "formal_git_unchanged": {
          "const": true
        },
        "data_files_unchanged": {
          "const": true
        },
        "production_switch_performed": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "1.6.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["blocking_gates", "completed_gates", "runtime_mounts", "candidate_runtime_access"],
        "properties": {
          "checks": {
            "required": ["server_store_contract"]
          }
        }
      },
      "else": {
        "properties": { "status": { "const": "candidate-validated" } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "candidate-waiting-gate" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocking_gates": { "minItems": 1, "maxItems": 1 },
          "completed_gates": { "maxItems": 0 }
        },
        "required": ["blocking_gates", "completed_gates"]
      },
      "else": {
        "properties": { "blocking_gates": { "maxItems": 0 } }
      }
    }
  ],
  "$defs": {
    "serverStoreConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "resolved_path"],
      "properties": {
        "status": { "const": "passed" },
        "resolved_path": { "type": "string", "minLength": 1 }
      }
    },
    "serverStoreContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_status",
        "environment_variable",
        "container_root",
        "mount_status",
        "mount_target",
        "mount_read_only",
        "current_status",
        "package_id",
        "manifest_status",
        "identity_status",
        "resolved_data_root",
        "required_consumers"
      ],
      "properties": {
        "environment_status": { "const": "passed" },
        "environment_variable": { "const": "PUBLIC_DATA_SERVER_STORE_ROOT" },
        "container_root": { "const": "/app/01_data/public-data-server-store" },
        "mount_status": { "const": "passed" },
        "mount_target": { "const": "/app/01_data" },
        "mount_read_only": { "const": true },
        "current_status": { "const": "passed" },
        "package_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
        },
        "manifest_status": { "const": "passed" },
        "identity_status": { "const": "passed" },
        "resolved_data_root": {
          "type": "string",
          "pattern": "^/app/01_data/public-data-server-store/releases/[A-Za-z0-9][A-Za-z0-9._-]{0,199}/data$"
        },
        "required_consumers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domestic_spread",
            "international_spread",
            "weather",
            "domestic_basis"
          ],
          "properties": {
            "domestic_spread": { "$ref": "#/$defs/serverStoreConsumer" },
            "international_spread": { "$ref": "#/$defs/serverStoreConsumer" },
            "weather": { "$ref": "#/$defs/serverStoreConsumer" },
            "domestic_basis": { "$ref": "#/$defs/serverStoreConsumer" }
          }
        }
      }
    },
    "pendingGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "required_business_timezone", "required_window_start", "required_window_end_exclusive", "earliest_expected_business_date", "blocks_production_promotion", "description"],
      "properties": {
        "gate_id": { "const": "real_night_session_close_snapshot" },
        "status": { "const": "pending" },
        "required_business_timezone": { "const": "Asia/Shanghai" },
        "required_window_start": { "const": "08:30:00" },
        "required_window_end_exclusive": { "const": "08:33:00" },
        "earliest_expected_business_date": { "type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}" },
        "blocks_production_promotion": { "const": true },
        "description": { "const": "Real AkShare night_session_close validation is pending." }
      }
    },
    "completedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "business_date", "captured_at", "target_contracts", "available_contracts", "missing_contracts", "capture_status", "business_date_validation", "source_time_validation", "snapshot_freeze_validation", "cnf_refetch_validation", "snapshot_batch_id", "candidate_sha256"],
      "properties": {
        "gate_id": { "const": "real_night_session_close_snapshot" },
        "status": { "const": "completed" },
        "business_date": { "type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}" },
        "captured_at": { "type": "string", "minLength": 20 },
        "target_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "[A-Za-z0-9._-]+" }
        },
        "available_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "[A-Za-z0-9._-]+" }
        },
        "missing_contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "[A-Za-z0-9._-]+" }
        },
        "capture_status": {
          "enum": ["success", "passed_with_incomplete"]
        },
        "business_date_validation": { "const": "passed" },
        "source_time_validation": { "const": "passed" },
        "snapshot_freeze_validation": { "const": "passed" },
        "cnf_refetch_validation": { "const": "passed" },
        "snapshot_batch_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "candidate_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "importProfitRuntimeMount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount_id", "container_path", "mode", "runtime_kind", "candidate_batch_id", "required_environment_variable"],
      "properties": {
        "mount_id": { "const": "import_profit_candidate_runtime" },
        "container_path": { "const": "/app/runtime/import_profit" },
        "mode": { "const": "rw" },
        "runtime_kind": { "const": "import_profit_candidate" },
        "candidate_batch_id": { "type": "string", "pattern": "spread-[0-9]{8}-[0-9a-f]{12,40}-b[0-9]{2,}" },
        "required_environment_variable": { "const": "IMPORT_PROFIT_RUNTIME_ROOT" }
      }
    },
    "candidateRuntimeAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container_path", "environment_variable", "uid", "gid", "read_write_probe"],
      "properties": {
        "container_path": { "const": "/app/runtime/import_profit" },
        "environment_variable": { "const": "IMPORT_PROFIT_RUNTIME_ROOT" },
        "uid": { "type": "integer", "minimum": 0 },
        "gid": { "type": "integer", "minimum": 0 },
        "read_write_probe": { "const": "passed" }
      }
    },
    "formalContainerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_phase", "after_phase", "before", "after", "compared_fields", "differences", "formal_containers_unchanged"],
      "properties": {
        "before_phase": { "const": "before-candidate" },
        "after_phase": { "const": "after-candidate" },
        "before": { "type": "object" },
        "after": { "type": "object" },
        "compared_fields": { "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true },
        "differences": { "type": "array", "maxItems": 0 },
        "formal_containers_unchanged": { "const": true }
      }
    },
    "weatherRuntimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_variable",
        "production_host_path",
        "allowed_candidate_host_paths",
        "container_path",
        "read_only",
        "weather_data_dir",
        "host_path",
        "candidate_weather_data_dir"
      ],
      "properties": {
        "environment_variable": { "const": "WEATHER_RUNTIME_CURRENT_DIR" },
        "production_host_path": { "const": "/home/ubuntu/market-data-runtime/weather/processed" },
        "allowed_candidate_host_paths": {
          "const": [
            "/home/ubuntu/market-data-runtime/weather/processed"
          ]
        },
        "container_path": { "const": "/app/runtime/weather" },
        "read_only": { "const": true },
        "weather_data_dir": { "const": "/app/runtime/weather/current" },
        "host_path": { "const": "/home/ubuntu/market-data-runtime/weather/processed" },
        "candidate_weather_data_dir": { "enum": ["/app/runtime/weather/current", "/app/runtime/weather/next"] }
      }
    },
    "fullGitCommit": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "imageId": {
      "type": "string",
      "pattern": "sha256:[0-9a-f]{64}"
    },
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "logSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_status",
        "collected_at_utc",
        "requested_tail_lines",
        "max_bytes",
        "source_bytes",
        "stored_bytes",
        "sha256",
        "truncated",
        "tail_line_count",
        "tail_text",
        "warning_count",
        "error_count",
        "collection_warning"
      ],
      "properties": {
        "collection_status": {
          "enum": [
            "captured",
            "unavailable"
          ]
        },
        "collected_at_utc": {
          "type": "string",
          "minLength": 20
        },
        "requested_tail_lines": {
          "const": 200
        },
        "max_bytes": {
          "const": 65536
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stored_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "truncated": {
          "type": "boolean"
        },
        "tail_line_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "tail_text": {
          "type": "string"
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "collection_warning": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "collection_status": {
                "const": "captured"
              }
            },
            "required": [
              "collection_status"
            ]
          },
          "then": {
            "properties": {
              "collection_warning": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "collection_warning": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
