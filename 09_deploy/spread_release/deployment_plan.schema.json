{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity-research-system.invalid/schemas/spread-deployment-plan-1.6.0.json",
  "title": "spread-dashboard sealed production deployment plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "git_commit",
    "git_tree",
    "image_ref",
    "expected_image_id",
    "candidate_image_id",
    "candidate_result_file",
    "candidate_result_sha256",
    "candidate_container_removed",
    "formal_containers",
    "production_env_file",
    "production_env_baseline_sha256",
    "production_env_sha256",
    "USDA_DASHBOARD_URL",
    "OIL_WORLD_DASHBOARD_URL",
    "MARKET_DATA_GIT_HEAD",
    "weather_runtime_contract",
    "weather_candidate_mode",
    "weather_candidate_source",
    "weather_candidate_data_dir",
    "weather_runtime_current_dir",
    "weather_data_promotion_required",
    "weather_data_changed",
    "processed_next_created",
    "processed_current_modified",
    "tool_repo_root",
    "deployment_tool_revision",
    "compose_project",
    "production_service",
    "production_compose_file",
    "production_project_dir",
    "compose_template_sha256",
    "candidate_compose_sha256",
    "current_production_compose_sha256",
    "production_compose_sha256",
    "candidate_runtime_environment",
    "production_runtime_environment",
    "allowed_candidate_production_differences",
    "semantic_comparison",
    "production_service_scope",
    "current_production",
    "target_release",
    "deployment_action",
    "deployment_argv",
    "rollback_argv",
    "rollback_git_commit",
    "rollback_image_ref",
    "rollback_image_id",
    "readiness_policy",
    "created_at",
    "plan_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.6.0"
    },
    "release_id": {
      "type": "string",
      "pattern": "spread-[0-9]{8}-[0-9a-f]{12,40}-b[0-9]{2,}"
    },
    "git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "git_tree": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "image_ref": {
      "type": "string",
      "pattern": "(?:^|/)market-data-spread-dashboard:spread-[0-9]{8}-[0-9a-f]{12,40}-b[0-9]{2,}"
    },
    "expected_image_id": {
      "$ref": "#/$defs/imageId"
    },
    "candidate_image_id": {
      "$ref": "#/$defs/imageId"
    },
    "candidate_result_file": {
      "type": "string",
      "minLength": 1
    },
    "candidate_result_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_container_removed": {
      "const": true
    },
    "formal_containers": {
      "$ref": "#/$defs/formalContainerEvidence"
    },
    "production_env_file": {
      "type": "string",
      "minLength": 1
    },
    "production_env_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "production_env_baseline_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "USDA_DASHBOARD_URL": {
      "type": "string",
      "minLength": 8
    },
    "OIL_WORLD_DASHBOARD_URL": {
      "type": "string",
      "minLength": 8
    },
    "MARKET_DATA_GIT_HEAD": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "weather_runtime_contract": {
      "$ref": "#/$defs/weatherRuntimeContract"
    },
    "weather_candidate_mode": { "enum": ["current", "next"] },
    "weather_candidate_source": { "const": "/home/ubuntu/market-data-runtime/weather/processed" },
    "weather_candidate_data_dir": { "enum": ["/app/runtime/weather/current", "/app/runtime/weather/next"] },
    "weather_runtime_current_dir": { "const": "/home/ubuntu/market-data-runtime/weather/processed" },
    "weather_data_promotion_required": { "type": "boolean" },
    "weather_data_changed": { "type": "boolean" },
    "processed_next_created": { "const": false },
    "processed_current_modified": { "const": false },
    "tool_repo_root": {
      "type": "string",
      "minLength": 1
    },
    "deployment_tool_revision": {
      "$ref": "#/$defs/gitRevision"
    },
    "compose_project": {
      "const": "market-data"
    },
    "production_service": {
      "const": "spread-dashboard"
    },
    "production_compose_file": {
      "type": "string",
      "minLength": 1
    },
    "production_project_dir": {
      "type": "string",
      "minLength": 1
    },
    "compose_template_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_compose_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "current_production_compose_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "production_compose_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_runtime_environment": {
      "$ref": "#/$defs/runtimeEnvironment"
    },
    "production_runtime_environment": {
      "$ref": "#/$defs/runtimeEnvironment"
    },
    "allowed_candidate_production_differences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "USDA_DASHBOARD_URL",
          "OIL_WORLD_DASHBOARD_URL",
          "WEATHER_DATA_DIR"
        ]
      }
    },
    "semantic_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_semantics_equal",
        "candidate_semantic_sha256",
        "production_semantic_sha256"
      ],
      "properties": {
        "base_semantics_equal": {
          "const": true
        },
        "candidate_semantic_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "production_semantic_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "production_service_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "spread-dashboard"
      }
    },
    "current_production": {
      "$ref": "#/$defs/currentProduction"
    },
    "target_release": {
      "$ref": "#/$defs/targetRelease"
    },
    "deployment_action": {
      "const": "upgrade"
    },
    "deployment_argv": {
      "$ref": "#/$defs/composeArgv"
    },
    "rollback_argv": {
      "$ref": "#/$defs/composeArgv"
    },
    "rollback_git_commit": {
      "$ref": "#/$defs/fullGitCommit"
    },
    "rollback_image_ref": {
      "type": "string",
      "pattern": "(?:^|/)market-data-spread-dashboard:[A-Za-z0-9_][A-Za-z0-9_.-]*"
    },
    "rollback_image_id": {
      "$ref": "#/$defs/imageId"
    },
    "readiness_policy": {
      "$ref": "#/$defs/readinessPolicy"
    },
    "created_at": {
      "type": "string",
      "minLength": 20
    },
    "plan_status": {
      "const": "deployment_plan_sealed"
    }
  },
  "$defs": {
    "gitRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "git_tree"],
      "properties": {
        "git_commit": { "$ref": "#/$defs/fullGitCommit" },
        "git_tree": { "$ref": "#/$defs/fullGitCommit" }
      }
    },
    "productionEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SPREAD_IMAGE", "MARKET_DATA_GIT_HEAD", "USDA_DASHBOARD_URL", "OIL_WORLD_DASHBOARD_URL", "WEATHER_RUNTIME_CURRENT_DIR", "WEATHER_DATA_DIR"],
      "properties": {
        "SPREAD_IMAGE": { "type": "string", "minLength": 1 },
        "MARKET_DATA_GIT_HEAD": { "$ref": "#/$defs/fullGitCommit" },
        "USDA_DASHBOARD_URL": { "type": "string", "minLength": 8 },
        "OIL_WORLD_DASHBOARD_URL": { "type": "string", "minLength": 8 },
        "WEATHER_RUNTIME_CURRENT_DIR": { "const": "/home/ubuntu/market-data-runtime/weather/processed" },
        "WEATHER_DATA_DIR": { "const": "/app/runtime/weather/current" }
      }
    },
    "currentProduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "env_sha256", "image_ref", "image_id", "git_commit", "compose_sha256"],
      "properties": {
        "environment": { "$ref": "#/$defs/productionEnvironment" },
        "env_sha256": { "$ref": "#/$defs/sha256" },
        "image_ref": { "type": "string", "minLength": 1 },
        "image_id": { "$ref": "#/$defs/imageId" },
        "git_commit": { "$ref": "#/$defs/fullGitCommit" },
        "compose_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "targetRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "env_sha256", "release_id", "image_ref", "image_id", "git_commit", "git_tree", "oci_revision", "compose_sha256"],
      "properties": {
        "environment": { "$ref": "#/$defs/productionEnvironment" },
        "env_sha256": { "$ref": "#/$defs/sha256" },
        "release_id": { "type": "string", "minLength": 1 },
        "image_ref": { "type": "string", "minLength": 1 },
        "image_id": { "$ref": "#/$defs/imageId" },
        "git_commit": { "$ref": "#/$defs/fullGitCommit" },
        "git_tree": { "$ref": "#/$defs/fullGitCommit" },
        "oci_revision": { "$ref": "#/$defs/fullGitCommit" },
        "compose_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "composeArgv": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": { "type": "string", "minLength": 1 }
    },
    "formalContainerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_phase", "after_phase", "before", "after", "compared_fields", "differences", "formal_containers_unchanged"],
      "properties": {
        "before_phase": { "const": "after-candidate" },
        "after_phase": { "const": "pre-deploy" },
        "before": { "type": "object" },
        "after": { "type": "object" },
        "compared_fields": { "type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true },
        "differences": { "type": "array", "maxItems": 0 },
        "formal_containers_unchanged": { "const": true }
      }
    },
    "weatherRuntimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_variable",
        "production_host_path",
        "allowed_candidate_host_paths",
        "container_path",
        "read_only",
        "weather_data_dir"
      ],
      "properties": {
        "environment_variable": { "const": "WEATHER_RUNTIME_CURRENT_DIR" },
        "production_host_path": { "const": "/home/ubuntu/market-data-runtime/weather/processed" },
        "allowed_candidate_host_paths": {
          "const": [
            "/home/ubuntu/market-data-runtime/weather/processed"
          ]
        },
        "container_path": { "const": "/app/runtime/weather" },
        "read_only": { "const": true },
        "weather_data_dir": { "const": "/app/runtime/weather/current" }
      }
    },
    "fullGitCommit": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "imageId": {
      "type": "string",
      "pattern": "sha256:[0-9a-f]{64}"
    },
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "readinessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_timeout_seconds",
        "poll_interval_seconds",
        "request_timeout_seconds",
        "consecutive_successes",
        "health_endpoint_path",
        "success_http_status",
        "success_body_exact"
      ],
      "properties": {
        "total_timeout_seconds": {
          "type": "integer",
          "minimum": 60
        },
        "poll_interval_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "request_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "consecutive_successes": {
          "type": "integer",
          "minimum": 2
        },
        "health_endpoint_path": {
          "type": "string",
          "pattern": "^/[^?#]*$"
        },
        "success_http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "success_body_exact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "USDA_DASHBOARD_URL",
        "OIL_WORLD_DASHBOARD_URL",
        "WEATHER_DATA_DIR"
      ],
      "properties": {
        "USDA_DASHBOARD_URL": {
          "type": "string",
          "minLength": 8
        },
        "OIL_WORLD_DASHBOARD_URL": {
          "type": "string",
          "minLength": 8
        },
        "WEATHER_DATA_DIR": {
          "enum": ["/app/runtime/weather/current", "/app/runtime/weather/next"]
        }
      }
    }
  }
}
