# Local development address for the independently running USDA static dashboard.
USDA_DASHBOARD_URL=http://127.0.0.1:5173

# Local development address for the independently running Oil World dashboard.
OIL_WORLD_DASHBOARD_URL=http://127.0.0.1:5175/

# USDA NASS Quick Stats credential. Keep the real value in the local
# environment or an ignored .env file; never commit it.
NASS_API_KEY=
