[Unit]
Description=Verify and compact inactive public package copies without deleting history
After=docker.service
RequiresMountsFor=/var/lib/market-data/storage-hygiene

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /opt/market-data-maintenance/public_package_retention.py --config /etc/market-data/package-retention.json --apply
TimeoutStartSec=30min
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/market-data/storage-hygiene /var/lib/market-data/production-runtime /var/lib/market-data/production-data-automation/scheduled /home/ubuntu/market-data/01_data/public-data-server-store
PrivateTmp=true

