[Unit]
Description=Verify and compact inactive public package copies without deleting history
After=docker.service
RequiresMountsFor=/srv/market-data-disk/active

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /opt/market-data-maintenance/public_package_retention.py --config /etc/market-data/package-retention.json --apply
TimeoutStartSec=30min
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# Use one physical data-disk view so atomic links share the same mount instance.
ReadWritePaths=/srv/market-data-disk/active
PrivateTmp=true

